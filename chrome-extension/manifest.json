{
  "manifest_version": 3,
  "name": "Giac Feedback Ordini PrestaShop",
  "version": "0.2.7",
  "description": "Beta: mostra nella lista e nel dettaglio ordini PrestaShop il feedback di disponibilità calcolato dalla webapp Giac.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Giac Feedback Ordini",
    "default_popup": "popup.html"
  }
}
